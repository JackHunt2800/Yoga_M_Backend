PORT=3001

# ========================================================
# Firebase Configuration (Firestore & Google Auth)
# ========================================================
FIREBASE_PROJECT_ID=yoga-app-9c8d5

# OPTION 1 (RECOMMENDED - No JSON file in project):
# From your downloaded service account JSON:
# 1. Copy the "client_email" value:
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@yoga-app-9c8d5.iam.gserviceaccount.com
# 2. Copy the "private_key" value (wrap in double quotes):
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# OPTION 2: Entire JSON as a single string variable:
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"yoga-app-9c8d5",...}'

# OPTION 3: External file path located outside your project folder:
# FIREBASE_SERVICE_ACCOUNT_PATH=C:/Users/YourName/Secrets/serviceAccountKey.json

# ========================================================
# Supabase File Storage (Free 1 GB tier, 50MB max file size)
# ========================================================
# Find in Supabase Dashboard -> Project Settings -> API:
SUPABASE_URL=https://your-project-id.supabase.co
# Use service_role secret key for backend, or anon public key with public bucket
SUPABASE_KEY=your_supabase_api_key_here
# Name of public storage bucket created in Supabase -> Storage
SUPABASE_BUCKET_NAME=yoga-media

SUPABASE_SERVICE_ROLE_KEY=

